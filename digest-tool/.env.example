# Copy to .env and fill in what you need. Nothing here is required:
# with LLM_PROVIDER=none the tool runs entirely from data/cache/.

# "none" | "ollama" | "anthropic"
LLM_PROVIDER=none

# Only for LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Only for LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b

# Only for MESSAGE_SOURCE=slack (needs channels:read and channels:history scopes)
MESSAGE_SOURCE=fake
SLACK_BOT_TOKEN=
